{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "CustomerSupport",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "CustomerSupport"
  },
  "runtimes": [
    {
      "name": "CustomerSupport",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerSupport/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "X-Amzn-Bedrock-AgentCore-Runtime-Custom-User-Id",
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_pRNo8iFqw/.well-known/openid-configuration",
          "allowedClients": [
            "1ugnuq4tobfg3jnclqofaj3ouv",
            "593ru0bal4vj75hosqkf5bt4jd"
          ]
        }
      }
    },
    {
      "name": "CustomerSupportAB",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/CustomerSupportAB/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [
    {
      "name": "SharedMemory",
      "eventExpiryDuration": 30,
      "strategies": [
        {
          "type": "SEMANTIC",
          "namespaceTemplates": [
            "/users/{actorId}/facts"
          ]
        },
        {
          "type": "SUMMARIZATION",
          "namespaceTemplates": [
            "/summaries/{actorId}/{sessionId}"
          ]
        }
      ]
    }
  ],
  "knowledgeBases": [],
  "credentials": [
    {
      "authorizerType": "OAuthCredentialProvider",
      "name": "gateway-egress-oauth",
      "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_pRNo8iFqw/.well-known/openid-configuration",
      "scopes": [
        "agentcore/invoke"
      ],
      "vendor": "CustomOauth2"
    }
  ],
  "evaluators": [],
  "onlineEvalConfigs": [
    {
      "name": "QualityMonitor",
      "agent": "CustomerSupport",
      "evaluators": [
        "Builtin.GoalSuccessRate",
        "Builtin.Correctness",
        "Builtin.ToolSelectionAccuracy"
      ],
      "samplingRate": 100,
      "enableOnCreate": true
    },
    {
      "name": "ABQualityMonitor",
      "agent": "CustomerSupportAB",
      "evaluators": [
        "Builtin.GoalSuccessRate"
      ],
      "samplingRate": 100,
      "enableOnCreate": true
    }
  ],
  "agentCoreGateways": [
    {
      "name": "my-gateway-secure",
      "protocolType": "None",
      "description": "Gateway for my-gateway-secure",
      "targets": [
        {
          "name": "WarrantyCheck",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:415087856646:function:workshop-warranty-check",
            "toolSchemaFile": "app/CustomerSupport/tool/warranty_schema.json"
          }
        },
        {
          "name": "ProcessRefund",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:415087856646:function:workshop-process-refund",
            "toolSchemaFile": "app/CustomerSupport/tool/refund_schema.json"
          }
        },
        {
          "name": "customer-support-ab",
          "targetType": "httpRuntime",
          "httpRuntime": {
            "runtime": "CustomerSupportAB"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_pRNo8iFqw/.well-known/openid-configuration",
          "allowedClients": [
            "1ugnuq4tobfg3jnclqofaj3ouv",
            "593ru0bal4vj75hosqkf5bt4jd"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "CustomerSupportPolicyEngine",
        "mode": "ENFORCE"
      }
    }
  ],
  "unassignedTargets": [
    {
      "name": "WarrantyCheck",
      "targetType": "lambdaFunctionArn",
      "lambdaFunctionArn": {
        "lambdaArn": "arn:aws:lambda:us-east-1:415087856646:function:workshop-warranty-check",
        "toolSchemaFile": "app/CustomerSupport/tool/warranty_schema.json"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "CustomerSupportPolicyEngine",
      "description": "Governs customer support agent tool access - refund limits and tool permissions",
      "policies": [
        {
          "name": "refund_limit_policy",
          "description": "Allow refunds under 100 dollars only",
          "statement": "permit(principal, action == AgentCore::Action::\"ProcessRefund___process_refund\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:415087856646:gateway/customersupport-my-gateway-secure-ir7bkffiqp\") when { ((context.input).amount) < 100 };",
          "validationMode": "FAIL_ON_ANY_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "warranty_check_policy",
          "description": "Allow all authenticated users to check warranties",
          "statement": "permit(principal, action == AgentCore::Action::\"WarrantyCheck___check_warranty\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:415087856646:gateway/customersupport-my-gateway-secure-ir7bkffiqp\");",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        },
        {
          "name": "refund_reason_policy",
          "description": "Forbid refunds when the reason does not contain the word defective",
          "statement": "forbid(principal, action == AgentCore::Action::\"ProcessRefund___process_refund\", resource == AgentCore::Gateway::\"arn:aws:bedrock-agentcore:us-east-1:415087856646:gateway/customersupport-my-gateway-secure-ir7bkffiqp\") unless { (context.input).reason like \"*defective*\" };",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [
    {
      "name": "customerSupportControl",
      "type": "ConfigurationBundle",
      "components": {
        "{{runtime:CustomerSupportAB}}": {
          "configuration": {
            "system_prompt": "You are a helpful and professional customer support assistant for an e-commerce company. Your role is to: provide accurate information using tools, be friendly and patient, always offer additional help, and direct customers to appropriate contacts when needed."
          }
        }
      },
      "branchName": "mainline",
      "commitMessage": "Baseline prompt"
    },
    {
      "name": "customerSupportTreatment",
      "type": "ConfigurationBundle",
      "components": {
        "{{runtime:CustomerSupportAB}}": {
          "configuration": {
            "system_prompt": "You are a helpful and professional customer support assistant for an e-commerce company.\nYour role is to:\n- Provide accurate information using the tools available to you\n- Be friendly, patient, and understanding with customers\n- Always offer additional help after answering questions\n- If you can't help with something, direct customers to the appropriate contact\n\nYou have access to tools for looking up return policies, searching product information, and more.\nAdditional tools may be available at runtime - always check your full tool list and use the most appropriate tool for each customer request.\nAlways use tools to get accurate, up-to-date information rather than guessing. When a search returns no results, retry with alternative queries (product IDs, category names, or synonyms).\n\nUse <user_context> and conversation history to understand the customer's situation and owned products. When context makes clear which product or issue the user means, act on it directly—do not ask them to clarify information already provided.\n\nBefore taking any action with real-world consequences (returns, refunds, claims), state the planned action and wait for explicit user approval"
          }
        }
      },
      "branchName": "mainline",
      "commitMessage": "Recommended prompt from cs-prompt-rec"
    }
  ],
  "abTests": [],
  "harnesses": [
    {
      "name": "OrderResearchAgent",
      "path": "app/OrderResearchAgent"
    }
  ],
  "datasets": [],
  "payments": []
}
